---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';

const title = 'Solar Company in Abuja | Installation, Inverters & Batteries | Tecil Solar';
const description = 'Professional solar installation in Abuja. Inverters, lithium batteries & solar panels for homes and businesses. Free site survey. Tecil Solar — Nigeria\'s solar specialists since 2008.';

// Exact coordinates from the verified GBP listing pin
const latitude = 9.1127665;
const longitude = 7.4024127;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Tecil Solar Abuja",
      "image": "https://www.tecilsolar.com/api/og.png",
      "url": "https://www.tecilsolar.com/solar-installation-in-abuja",
      "telephone": "+2349128136115",
      "priceRange": "₦₦",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "8 Hafsat Hamadu Bello St, Gwarinpa",
        "addressLocality": "Abuja",
        "addressRegion": "Federal Capital Territory",
        "postalCode": "900108",
        "addressCountry": "NG"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": latitude, "longitude": longitude },
      // TODO: confirm hours with branch
      "openingHours": "Mo-Sa 08:00-17:00",
      "areaServed": ["Gwarinpa", "Wuse 2", "Maitama", "Garki", "Kubwa", "Lugbe", "Nyanya", "Karu"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a solar system cost in Abuja?",
          "acceptedAnswer": { "@type": "Answer", "text": "Cost depends on your power needs, which we calculate during a free site survey and load assessment. A small system for lights, fans and TV costs far less than one that runs air conditioners and freezers. After the survey, you get an exact quote — no guesswork." }
        },
        {
          "@type": "Question",
          "name": "Do you offer free site surveys in Abuja?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our Abuja team carries out free site surveys and load assessments across the FCT before recommending any system." }
        },
        {
          "@type": "Question",
          "name": "How long does a home installation take?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most residential installations are completed within 1–3 days after the site survey, depending on system size and roof or ground mounting requirements." }
        },
        {
          "@type": "Question",
          "name": "Can solar power my air conditioner or freezer?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — with correct sizing. Inverter air conditioners and modern freezers are far more efficient, and we design systems around your actual load so they run reliably." }
        },
        {
          "@type": "Question",
          "name": "Do you offer maintenance after installation?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. We provide ongoing maintenance, repairs and support, backed by a nationwide branch network — so help is always near, even years after installation." }
        }
      ]
    }
  ]
};
---
<Layout title={title} description={description} page="branches">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- ── PAGE HERO ── -->
  <section class="page-hero">
    <div class="container">
      <p class="section-tag">Tecil Solar · Abuja Branch</p>
      <h1>Solar Company in Abuja — Installation, Inverters & Batteries</h1>
      <p class="hero-lede">
        Unstable power doesn't have to be your normal. Tecil Solar's Abuja branch designs,
        supplies and installs complete solar systems for homes, offices, shops and institutions
        across the FCT — backed by Nigeria's solar and inverter specialists since 2008.
      </p>
      <div class="hero-cta">
        <a class="btn-whatsapp" href="https://wa.me/2348037135545" target="_blank" rel="noopener">Chat on WhatsApp</a>
        <a class="btn-outline" href="tel:+2349128136115">Call Abuja Office</a>
      </div>
    </div>
  </section>

  <!-- ── BRANCH / MAP ── -->
  <section class="block">
    <div class="container">
      <p class="section-tag">Visit Us</p>
      <h2>Our Abuja Branch</h2>
      <div class="branch-grid">
        <div class="branch-card">
          <h3>Tecil Solar Abuja</h3>
          <p>📍 8 Hafsat Hamadu Bello St, Gwarinpa, Abuja 900108, FCT <span class="addr-alias">(House 8, 37th Road, 3rd Avenue — Gwarinpa's numbered grid, same building)</span></p>
          <p>📞 <a href="tel:+2349128136115">+234 912 813 6115</a></p>
          <p>🕒 Monday – Saturday · 8:00 am – 5:00 pm</p>
          <a class="btn-primary" href="https://wa.me/2348037135545" target="_blank" rel="noopener">Get a Free Site Survey</a>
        </div>
        <div class="map-wrap">
          <iframe
            title="Tecil Solar Abuja location map"
            src="https://www.google.com/maps?q=9.1127665,7.4024127&z=17&output=embed"
            width="100%"
            height="340"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES ── -->
  <section class="block block-alt">
    <div class="container">
      <p class="section-tag">What We Do</p>
      <h2>Solar Services in Abuja</h2>
      <div class="services-grid">
        <a class="service-card" href="/services#installation">
          <strong>Solar Installation</strong>
          <span>Full system design and installation for homes and businesses.</span>
          <em>Learn more →</em>
        </a>
        <a class="service-card" href="/products">
          <strong>Inverters & Batteries</strong>
          <span>Quality inverters, lithium and tubular batteries from trusted brands.</span>
          <em>View products →</em>
        </a>
        <a class="service-card" href="/services#assessment">
          <strong>Load Assessment</strong>
          <span>We size your system properly — free survey, exact quote.</span>
          <em>Learn more →</em>
        </a>
        <a class="service-card" href="/services#maintenance">
          <strong>Maintenance & Repair</strong>
          <span>Keep your system performing for years, with support near you.</span>
          <em>Learn more →</em>
        </a>
      </div>
    </div>
  </section>

  <!-- ── PROOF SECTION ── -->
  <!-- TODO: replace with real Abuja project photos + a real customer quote -->
  <section class="block">
    <div class="container">
      <p class="section-tag">Our Work</p>
      <h2>Recent Projects in Abuja</h2>
      <p class="body-copy">
        From family homes in Gwarinpa to offices and shops across the city, our Abuja team has
        designed and delivered systems of every size. Ask us for references near you — or browse
        <a href="/projects">our nationwide project gallery</a>.
      </p>
      <blockquote class="quote">
        “Reliable power. Expert hands. Products that last.” — the promise we make to every Abuja
        customer. See what customers say on
        <a href="https://www.google.com/search?q=Tecil+Solar+Abuja+reviews" target="_blank" rel="noopener">our Google reviews</a>.
      </blockquote>
    </div>
  </section>

  <!-- ── AREAS ── -->
  <section class="block block-alt">
    <div class="container">
      <p class="section-tag">Coverage</p>
      <h2>Areas We Serve in Abuja</h2>
      <p class="body-copy">
        We install and maintain solar systems across the FCT, including
        <strong>Gwarinpa, Wuse 2, Maitama, Garki, Kubwa, Lugbe, Nyanya, Karu</strong>
        and surrounding districts. If you're within Abuja, our team can reach you.
        Not in Abuja? <a href="/branches">Find your nearest branch</a>.
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="block">
    <div class="container">
      <p class="section-tag">Answers</p>
      <h2>Frequently Asked Questions</h2>
      <div class="faq">
        <details>
          <summary>How much does a solar system cost in Abuja?</summary>
          <p>Cost depends on your power needs, which we calculate during a free site survey and load assessment. A small system for lights, fans and TV costs far less than one that runs air conditioners and freezers. After the survey, you get an exact quote — no guesswork.</p>
        </details>
        <details>
          <summary>Do you offer free site surveys in Abuja?</summary>
          <p>Yes. Our Abuja team carries out free site surveys and load assessments across the FCT before recommending any system.</p>
        </details>
        <details>
          <summary>How long does a home installation take?</summary>
          <p>Most residential installations are completed within 1–3 days after the site survey, depending on system size and mounting requirements.</p>
        </details>
        <details>
          <summary>Can solar power my air conditioner or freezer?</summary>
          <p>Yes — with correct sizing. Inverter air conditioners and modern freezers are far more efficient, and we design systems around your actual load so they run reliably.</p>
        </details>
        <details>
          <summary>Do you offer maintenance after installation?</summary>
          <p>Yes. We provide ongoing maintenance, repairs and support, backed by a nationwide branch network — so help is always near, even years after installation.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <CTASection />
</Layout>

<style>
  .page-hero { padding: 5rem 0 3.5rem; }
  .hero-lede { max-width: 46rem; line-height: 1.65; margin: 1rem 0 0; }
  .hero-cta { display: flex; gap: .8rem; flex-wrap: wrap; margin-top: 1.6rem; }

  .block { padding: 3rem 0; }
  .block-alt { background: #faf7f7; }

  .branch-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.5rem; align-items: start; margin-top: 1.2rem; }
  .branch-card { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: .6rem; align-items: flex-start; }
  .branch-card h3 { margin: 0; color: #CC1417; }
  .branch-card p { margin: 0; line-height: 1.55; }
  .addr-alias { display: block; color: #777; font-size: .85rem; margin-top: .15rem; }
  .map-wrap { border-radius: 12px; overflow: hidden; border: 1px solid #eee; }
  .map-wrap iframe { display: block; }

  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; margin-top: 1.2rem; }
  .service-card { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 1.2rem; display: flex; flex-direction: column; gap: .45rem; text-decoration: none; color: inherit; transition: border-color .2s; }
  .service-card:hover { border-color: #CC1417; }
  .service-card strong { color: #CC1417; }
  .service-card span { line-height: 1.5; font-size: .95rem; }
  .service-card em { font-style: normal; font-weight: 700; font-size: .88rem; }

  .body-copy { max-width: 46rem; line-height: 1.65; }
  .quote { margin: 1.2rem 0 0; padding: 1.1rem 1.4rem; border-left: 4px solid #CC1417; background: #fff; border-radius: 0 12px 12px 0; font-style: italic; line-height: 1.6; max-width: 46rem; }

  .faq { max-width: 46rem; margin-top: 1.2rem; display: flex; flex-direction: column; gap: .7rem; }
  .faq details { background: #fff; border: 1px solid #eee; border-radius: 10px; padding: .9rem 1.2rem; }
  .faq summary { font-weight: 700; cursor: pointer; }
  .faq details[open] summary { color: #CC1417; }
  .faq p { margin: .7rem 0 0; line-height: 1.6; color: #444; }

  @media (max-width: 820px) {
    .branch-grid { grid-template-columns: 1fr; }
    .page-hero { padding: 3.5rem 0 2.5rem; }
  }
</style>