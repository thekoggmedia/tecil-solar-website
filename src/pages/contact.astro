---
import Layout from '../layouts/Layout.astro';
import MarqueeStrip from '../components/MarqueeStrip.astro';
import CTASection from '../components/CTASection.astro';

const branches = [
  { label: 'Calabar HQ', phone: '08037135545' },
  { label: 'Calabar South', phone: '09071242120' },
  { label: 'Ikom', phone: '08035601371' },
  { label: 'Port Harcourt 1', phone: '07016164397' },
  { label: 'Port Harcourt 2', phone: '07016164397' },
  { label: 'Uyo', phone: '08121138060' },
  { label: 'Lagos / Ikeja', phone: '08026835985' },
];

const trustPoints = [
  'Free load assessment before any quote',
  'Response within 24 hours guaranteed',
  'No pushy sales — honest advice only',
  'Serving Nigeria since 2008',
];
---

<Layout
  title="Get a Quote — TECIL Solar"
  description="Contact TECIL Solar for a free solar assessment and quote."
  page="contact"
>

<section class="page-hero">
  <div class="page-hero-grid"></div>
  <div class="page-hero-orb a"></div>
  <div class="page-hero-orb b"></div>

  <div class="container">
    <span class="section-tag">Get a Quote</span>

    <h1>
      Let's Talk<br />
      <span class="text-gradient">About Your Power.</span>
    </h1>

    <p class="page-hero-sub">
      Tell us what you need — a home backup system,
      commercial installation or large-scale project.
    </p>
  </div>
</section>

<MarqueeStrip variant="red" />

<section class="section bg-off">
  <div class="container contact-shell">

    <!-- LEFT -->
    <div class="contact-left">

      <div class="cc-block reveal">
        <h3 class="cc-title">Reach Us Directly</h3>

        <a
          href="https://wa.me/2348037135545"
          target="_blank"
          rel="noopener"
          class="cc-card"
        >
          <div class="cc-icon">💬</div>

          <div class="cc-info">
            <strong>WhatsApp</strong>
            <span>Fastest response channel</span>
          </div>
        </a>

        <a href="tel:+2348037135545" class="cc-card">
          <div class="cc-icon">📞</div>

          <div class="cc-info">
            <strong>Call HQ</strong>
            <span>0803 713 5545</span>
          </div>
        </a>

        <a
          href="mailto:tecilsolarcustomercare@gmail.com"
          class="cc-card"
        >
          <div class="cc-icon">✉️</div>

          <div class="cc-info">
            <strong>Email</strong>
            <span>tecilsolarcustomercare@gmail.com</span>
          </div>
        </a>
      </div>

      <div class="trust-block reveal">
        {trustPoints.map((point) => (
          <div class="trust-row">
            <div class="trust-dot"></div>
            <span>{point}</span>
          </div>
        ))}
      </div>

    </div>

    <!-- RIGHT -->
    <div class="contact-right reveal">

      <div class="form-card">

        <div class="form-card-head">
          <span class="section-tag">Free Quote Request</span>

          <h2>
            Tell Us What<br />
            You Need
          </h2>

          <p class="form-sub">
            Fill the form below and our team will respond quickly.
          </p>
        </div>

        <form
          id="contact-form"
          class="cform"
        >

          <!-- Honeypot -->
          <div class="hp-wrap" aria-hidden="true">
            <label for="website">Website</label>

            <input
              type="text"
              id="website"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="form-row">

            <div class="form-field">
              <label for="cf-name">
                <span class="field-label">Your Name</span>

                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  placeholder="Full name"
                  required
                />
              </label>
            </div>

            <div class="form-field">
              <label for="cf-phone">
                <span class="field-label">Phone Number</span>

                <input
                  id="cf-phone"
                  name="phone"
                  type="tel"
                  placeholder="0803 000 0000"
                  required
                />
              </label>
            </div>

          </div>

          <div class="form-row">

            <div class="form-field">
              <label for="cf-email">
                <span class="field-label">
                  Email
                </span>

                <input
                  id="cf-email"
                  name="email"
                  type="email"
                  placeholder="name@example.com"
                />
              </label>
            </div>

            <div class="form-field">
              <label for="cf-location">
                <span class="field-label">
                  Location
                </span>

                <input
                  id="cf-location"
                  name="location"
                  type="text"
                  placeholder="Lagos, PH, Calabar..."
                  required
                />
              </label>
            </div>

          </div>

          <div class="form-field full">

            <label for="cf-branch">

              <span class="field-label">
                Nearest Branch
              </span>

              <div class="select-wrap">

                <select id="cf-branch" name="branch">

                  <option value="">
                    Select Branch
                  </option>

                  {branches.map((branch) => (
                    <option value={branch.label}>
                      {branch.label}
                    </option>
                  ))}

                </select>

              </div>

            </label>

          </div>

          <div class="form-field full">

            <label for="cf-type">

              <span class="field-label">
                Enquiry Type
              </span>

              <div class="select-wrap">

                <select id="cf-type" name="type">

                  <option value="">
                    Select Enquiry Type
                  </option>

                  <option>Home Solar System</option>
                  <option>Commercial Installation</option>
                  <option>Institutional Project</option>
                  <option>Maintenance / Repairs</option>
                  <option>Technical Advisory</option>
                  <option>Training</option>
                  <option>Other</option>

                </select>

              </div>

            </label>

          </div>

          <div class="form-field full">

            <label for="cf-message">

              <span class="field-label">
                Message
              </span>

              <textarea
                id="cf-message"
                name="message"
                rows="6"
                placeholder="Tell us about your project..."
                required
              ></textarea>

            </label>

          </div>

          <!-- Cloudflare Turnstile -->
          <div class="turnstile-wrap">
            <div
              class="cf-turnstile"
              data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
            ></div>
          </div>

          <button
            class="cform-submit"
            id="submit-btn"
            type="submit"
          >
            Send Enquiry
          </button>

          <p class="form-note" id="form-note">
            Our team responds within 24 hours.
          </p>

        </form>

      </div>

    </div>

  </div>
</section>

<CTASection />

<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>

<script is:inline>
const form = document.getElementById('contact-form');
const button = document.getElementById('submit-btn');
const note = document.getElementById('form-note');

form?.addEventListener('submit', async (e) => {

  e.preventDefault();

  const originalButton = button.innerHTML;

  button.disabled = true;
  button.innerHTML = 'Sending...';

  note.textContent =
    'Submitting your enquiry...';

  try {

    const formData =
      new FormData(form);

    const response =
      await fetch('/api/contact', {

      method: 'POST',

      headers: {
        'Content-Type': 'application/json',
      },

      body: JSON.stringify({
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        location: formData.get('location'),
        branch: formData.get('branch'),
        type: formData.get('type'),
        message: formData.get('message'),

        website:
          formData.get('website'),

        turnstileToken:
          formData.get(
            'cf-turnstile-response'
          ),
      }),
    });

    const result =
      await response.json();

    if (!response.ok) {
      throw new Error(
        result.error || 'Failed'
      );
    }

    note.textContent =
      '✓ Enquiry sent successfully. TECIL Solar will contact you shortly.';

    form.reset();

    const whatsappText = `
Hello TECIL Solar,

My enquiry has just been submitted through your website.

Name: ${formData.get('name')}
Phone: ${formData.get('phone')}
Location: ${formData.get('location')}
`;

    window.open(
      `https://wa.me/2348037135545?text=${encodeURIComponent(whatsappText)}`,
      '_blank'
    );

  } catch (error) {

    console.error(error);

    note.textContent =
      'Something went wrong. Please try again or contact us via WhatsApp.';

  } finally {

    button.disabled = false;
    button.innerHTML =
      originalButton;

  }

});
</script>

</Layout>

<style>
.contact-shell{
  display:grid;
  grid-template-columns:1fr 1.3fr;
  gap:3rem;
  align-items:start;
}

.contact-left{
  display:flex;
  flex-direction:column;
  gap:1.5rem;
}

.cc-title{
  font-size:.75rem;
  text-transform:uppercase;
  letter-spacing:.12em;
  margin-bottom:1rem;
  color:#9CA3AF;
  font-weight:800;
}

.cc-card{
  display:flex;
  align-items:center;
  gap:14px;
  padding:1rem 1.2rem;
  border-radius:14px;
  border:1px solid #E5E7EB;
  background:#fff;
  text-decoration:none;
  margin-bottom:10px;
  transition:.25s ease;
}

.cc-card:hover{
  transform:translateY(-3px);
  box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.cc-icon{
  width:46px;
  height:46px;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#F3F4F6;
  font-size:1.1rem;
}

.cc-info strong{
  display:block;
  color:#111827;
  margin-bottom:2px;
}

.cc-info span{
  font-size:.8rem;
  color:#6B7280;
}

.trust-block{
  background:#fff;
  border-radius:14px;
  border:1px solid #E5E7EB;
  padding:1.4rem;
}

.trust-row{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:12px;
}

.trust-row:last-child{
  margin-bottom:0;
}

.trust-dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#CC1417;
}

.form-card{
  background:#fff;
  border-radius:18px;
  overflow:hidden;
  border:1px solid #E5E7EB;
  box-shadow:0 10px 40px rgba(0,0,0,.05);
}

.form-card-head{
  padding:2rem;
  background:linear-gradient(
    135deg,
    #0F1117,
    #1A1F2E
  );
}

.form-card-head h2{
  color:#fff;
  margin:.5rem 0;
}

.form-sub{
  color:rgba(255,255,255,.65);
}

.cform{
  padding:2rem;
}

.form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:1rem;
}

.form-field{
  margin-bottom:1rem;
}

.field-label{
  display:block;
  margin-bottom:.5rem;
  font-size:.72rem;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:#9CA3AF;
}

input,
textarea,
select{
  width:100%;
  padding:.9rem 1rem;
  border-radius:10px;
  border:1.5px solid #E5E7EB;
  background:#F9FAFB;
  font-family:inherit;
  transition:.2s ease;
}

input:focus,
textarea:focus,
select:focus{
  outline:none;
  border-color:#CC1417;
  background:#fff;
}

textarea{
  resize:vertical;
}

.hp-wrap{
  position:absolute;
  left:-9999px;
  opacity:0;
  pointer-events:none;
}

.turnstile-wrap{
  margin-bottom:1rem;
}

.cform-submit{
  width:100%;
  padding:1rem;
  border:none;
  border-radius:12px;
  background:linear-gradient(
    135deg,
    #CC1417,
    #E8601A
  );
  color:#fff;
  font-weight:800;
  cursor:pointer;
  transition:.25s ease;
}

.cform-submit:hover{
  transform:translateY(-2px);
}

.form-note{
  margin-top:1rem;
  text-align:center;
  font-size:.8rem;
  color:#6B7280;
}

@media(max-width:1024px){

  .contact-shell{
    grid-template-columns:1fr;
  }

}

@media(max-width:640px){

  .form-row{
    grid-template-columns:1fr;
  }

  .cform{
    padding:1.5rem;
  }

}
</style>