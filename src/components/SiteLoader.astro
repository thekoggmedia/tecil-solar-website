<div id="site-loader" class="site-loader">
  <div class="loader-inner">

    <img
      src="/logo-mark.svg"
      alt="TECIL Solar"
      class="loader-logo"
    />

    <div class="loader-text">
      Loading TECIL Solar...
    </div>

  </div>
</div>

<style>
.site-loader {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #ffffff;

  transition:
    opacity .45s ease,
    visibility .45s ease;
}

.site-loader.hidden {
  opacity: 0;
  visibility: hidden;
}

.loader-inner {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:1.25rem;
}

.loader-logo {
  width:90px;
  height:90px;

  animation:
    tecilSpin 2.5s linear infinite,
    tecilGlow 2s ease-in-out infinite;
}

.loader-text {
  font-size:.85rem;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;

  color:#CC1417;
}

@keyframes tecilSpin {
  from {
    transform:rotate(0deg);
  }

  to {
    transform:rotate(360deg);
  }
}

@keyframes tecilGlow {

  0% {
    filter:
      drop-shadow(0 0 0 rgba(204,20,23,.2));
  }

  50% {
    filter:
      drop-shadow(0 0 18px rgba(204,20,23,.45));
  }

  100% {
    filter:
      drop-shadow(0 0 0 rgba(204,20,23,.2));
  }
}
</style>

<script>
window.addEventListener('load', () => {

  const loader =
    document.getElementById('site-loader');

  if (!loader) return;

  setTimeout(() => {
    loader.classList.add('hidden');
  }, 350);

});
</script>