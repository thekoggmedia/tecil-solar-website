---
/*
  TECIL Solar Product Modal
  Phase 3 Production Version
*/
---

<div id="product-modal" class="pmodal">

  <div
    class="pmodal-overlay"
    id="pmodal-close"
  ></div>

  <div class="pmodal-container">

    <button
      class="pmodal-close"
      id="pmodal-close-btn"
      aria-label="Close Modal"
    >
      ✕
    </button>

    <div class="pmodal-content">

      <!-- IMAGE -->

      <div class="pmodal-media">

        <img
          id="pmodal-image"
          src=""
          alt=""
        />

      </div>

      <!-- INFO -->

      <div class="pmodal-info">

        <div class="pmodal-head">

          <div
            id="pmodal-brand"
            class="pmodal-brand"
          ></div>

          <h2
            id="pmodal-name"
            class="pmodal-title"
          ></h2>

        </div>

        <div
          class="pmodal-specs"
          id="pmodal-specs"
        ></div>

        <div class="pmodal-price-wrap">

          <div
            id="pmodal-price"
            class="pmodal-price"
          ></div>

          <span class="pmodal-price-note">
            Market price may vary slightly
          </span>

        </div>

        <div class="pmodal-actions">

          <button
            id="pmodal-cart"
            class="pmodal-cart"
          >
            Add To Cart
          </button>

          <button
            id="pmodal-enquiry"
            class="pmodal-enquiry"
          >
            Quick Enquiry
          </button>

        </div>

      </div>

    </div>

  </div>

</div>

<style>
.pmodal{
  position:fixed;
  inset:0;
  z-index:9999;
  display:none;
}

.pmodal.active{
  display:block;
}

.pmodal-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.65);
  backdrop-filter:blur(6px);
}

.pmodal-container{
  position:relative;
  max-width:1100px;
  margin:5vh auto;
  background:#fff;
  border-radius:20px;
  overflow:hidden;

  box-shadow:
    0 40px 120px rgba(0,0,0,.35);

  animation:modalIn .35s ease;
}

@keyframes modalIn{
  from{
    transform:translateY(40px);
    opacity:0;
  }

  to{
    transform:translateY(0);
    opacity:1;
  }
}

.pmodal-close{
  position:absolute;
  top:16px;
  right:16px;

  width:40px;
  height:40px;

  border:none;
  border-radius:50%;

  background:#fff;

  cursor:pointer;

  z-index:10;
}

.pmodal-content{
  display:grid;
  grid-template-columns:1fr 1fr;
}

.pmodal-media{
  background:#F9FAFB;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:2rem;
}

.pmodal-media img{
  max-width:100%;
  max-height:450px;
  object-fit:contain;
}

.pmodal-info{
  padding:2.5rem;

  display:flex;
  flex-direction:column;

  gap:1.4rem;
}

.pmodal-brand{
  font-size:.75rem;
  font-weight:700;
  text-transform:uppercase;
  color:#9CA3AF;
}

.pmodal-title{
  font-size:1.5rem;
  font-weight:900;
  line-height:1.3;
}

.pmodal-specs{
  display:flex;
  flex-wrap:wrap;
  gap:.6rem;
}

.pmodal-spec{
  background:#F3F4F6;
  padding:.55rem .85rem;
  border-radius:8px;
  font-size:.75rem;
  font-weight:700;
}

.pmodal-price{
  font-size:2rem;
  font-weight:900;
  color:#CC1417;
}

.pmodal-price-note{
  font-size:.72rem;
  color:#6B7280;
}

.pmodal-actions{
  display:flex;
  gap:12px;
  margin-top:1rem;
}

.pmodal-cart{
  flex:1;

  border:none;

  background:
    linear-gradient(
      135deg,
      #CC1417,
      #E8601A
    );

  color:#fff;

  padding:1rem;

  border-radius:10px;

  font-weight:800;

  cursor:pointer;
}

.pmodal-cart:hover{
  opacity:.95;
}

.pmodal-enquiry{
  flex:1;

  background:#fff;

  border:2px solid #E5E7EB;

  padding:1rem;

  border-radius:10px;

  font-weight:700;

  cursor:pointer;
}

@media(max-width:900px){

  .pmodal-container{
    margin:0;
    height:100vh;
    border-radius:0;
  }

  .pmodal-content{
    grid-template-columns:1fr;
  }

  .pmodal-info{
    padding:1.5rem;
  }

}
</style>

<script>
const STORAGE_KEY = 'tecil-cart';

let currentProduct = null;

const modal =
  document.getElementById(
    'product-modal'
  );

function getCart() {

  try {

    return JSON.parse(
      localStorage.getItem(
        STORAGE_KEY
      )
    ) || [];

  } catch {

    return [];

  }

}

function saveCart(cart) {

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(cart)
  );

  window.dispatchEvent(
    new CustomEvent(
      'cart-updated',
      {
        detail: cart
      }
    )
  );

}

function addToCart(product) {

  const cart = getCart();

  const existing =
    cart.find(
      item => item.id === product.id
    );

  if (existing) {

    existing.qty += 1;

  } else {

    cart.push({
      ...product,
      qty: 1
    });

  }

  saveCart(cart);

}

function closeModal() {

  modal.classList.remove(
    'active'
  );

  document.body.style.overflow = '';

}

window.addEventListener(
  'open-product-modal',
  (e) => {

    const p = e.detail;

    currentProduct = p;

    document.getElementById(
      'pmodal-name'
    ).textContent = p.name || '';

    document.getElementById(
      'pmodal-brand'
    ).textContent = p.brand || '';

    document.getElementById(
      'pmodal-price'
    ).textContent =
      p.price || 'Request Price';

    const img =
      document.getElementById(
        'pmodal-image'
      );

    img.src = p.image || '';

    img.alt = p.name || '';

    img.onerror = () => {

      img.src =
        '/images/product-placeholder.webp';

    };

    const specs = [];

    if (p.capacity)
      specs.push(p.capacity);

    if (p.type)
      specs.push(p.type);

    if (p.category)
      specs.push(p.category);

    document.getElementById(
      'pmodal-specs'
    ).innerHTML =
      specs
        .map(
          item =>
            `<div class="pmodal-spec">${item}</div>`
        )
        .join('');

    modal.classList.add(
      'active'
    );

    document.body.style.overflow =
      'hidden';

  }
);

document
  .getElementById(
    'pmodal-close'
  )
  ?.addEventListener(
    'click',
    closeModal
  );

document
  .getElementById(
    'pmodal-close-btn'
  )
  ?.addEventListener(
    'click',
    closeModal
  );

document.addEventListener(
  'keydown',
  (e) => {

    if (
      e.key === 'Escape' &&
      modal.classList.contains(
        'active'
      )
    ) {
      closeModal();
    }

  }
);

document
  .getElementById(
    'pmodal-cart'
  )
  ?.addEventListener(
    'click',
    () => {

      if (!currentProduct)
        return;

      addToCart(
        currentProduct
      );

      const btn =
        document.getElementById(
          'pmodal-cart'
        );

      const original =
        btn.textContent;

      btn.textContent =
        'Added ✓';

      setTimeout(() => {

        btn.textContent =
          original;

      }, 1500);

    }
  );

document
  .getElementById(
    'pmodal-enquiry'
  )
  ?.addEventListener(
    'click',
    () => {

      if (!currentProduct)
        return;

      const msg =
        encodeURIComponent(
`Hello TECIL Solar,

I am interested in:

Product: ${currentProduct.name}
Brand: ${currentProduct.brand || ''}
Capacity: ${currentProduct.capacity || ''}

Please provide:

• Availability
• Installation options
• Quotation

Thank you.`
        );

      window.open(
        `https://wa.me/2348037135545?text=${msg}`,
        '_blank'
      );

    }
  );
</script>