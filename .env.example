# Copy to .env for local development.
# Production values live in Cloudflare Pages environment variables.

RESEND_API_KEY=
# Comma-separated recipients for contact form enquiries.
CONTACT_EMAIL=info@tecilsolar.com,info.tecilservices@gmail.com
# Custom sender — only works after verifying tecilsolar.com in Resend.
# Until then leave unset to use the Resend sandbox sender.
RESEND_FROM=

PUBLIC_SITE_URL=https://www.tecilsolar.com
PUBLIC_WA_NUMBER=2348037135545
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
